+        (D3DRS_LIGHTING, 1),
+        (D3DRS_COLORVERTEX, 1),
+        (D3DRS_LOCALVIEWER, 0),
+        (D3DRS_SPECULARENABLE, 1),
+        (D3DRS_AMBIENT, 0xFFFF_FFFF),
+    ] {
+        assert_eq!(h.set_render_state(state, value), 0);
+    }
+    h.select_diffuse_stage(0);
+    let white = D3DCOLORVALUE {

+case "close", "settings-close":
+ guard let b = attr(window,kAXCloseButtonAttribute) else {exit(1)}
+ let e=AXUIElementPerformAction(b as! AXUIElement,kAXPressAction as CFString)
+ if e != .success {exit(1)}
+default: exit(64)
+}

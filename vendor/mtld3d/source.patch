+    elements.push(D3DDECL_END);
+    let decl = h.create_vertex_declaration(&elements);
+    assert_eq!(h.set_vertex_declaration(&decl), 0);
+    assert_eq!(h.set_stream_source_null(1, 0, 0), 0);
+    assert_eq!(h.set_stream_source_null(2, 0, 0), 0);
+}

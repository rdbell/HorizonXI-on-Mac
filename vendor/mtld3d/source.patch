+        return;
+    }
+    run_on_main_thread_sync(move || {
+        if enabled {
+            // SAFETY: the calling device retains its view through this synchronous call.
+            native_host::attach(unsafe { &*(address as *const objc2_app_kit::NSView) });
+        } else {
+            native_host::detach(address);
+        }
+    });
+}

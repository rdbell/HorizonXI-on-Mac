+        g: 1.0,
+        b: 1.0,
+        a: 1.0,
+    };
+    let light = D3DLIGHT9 {
+        type_: D3DLIGHT_DIRECTIONAL,
+        diffuse: white,
+        specular: white,
+        direction: D3DVECTOR {
+            x: 0.0,
+            y: 0.0,
+            z: 1.0,
+        },
+        ..D3DLIGHT9::default()
+    };
+    assert_eq!(h.set_light(0, &light), 0);
+    assert_eq!(h.light_enable(0, true), 0);
+    let tri = [(0.0, 0.5), (0.5, -0.5), (-0.5, -0.5)].map(|(x, y)| LitVertex {

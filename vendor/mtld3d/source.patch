+            4 => state.passes[1].depth_texture = depth(),
+            5 => state.passes[2]
+                .commands
+                .insert(1, Command::set_fragment_texture(backbuffer().raw(), 0)),
+            _ => unreachable!(),
+        }
+        state.merge_independent_draw_passes();
+        assert_eq!(state.passes.len(), 3, "barrier={barrier}");
+    }
+}
